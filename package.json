  "files": [
    "index.ts",
    "tui.tsx",
    "gui-experimental.cjs",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@opencode/plugin": "latest"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.6.6",
    "@opentui/solid": ">=0.6.6",
    "solid-js": ">=1.9.0"
  }
