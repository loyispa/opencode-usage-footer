{
  "name": "opencode-usage-footer",
  "version": "0.1.0",
  "description": "Show OpenCode Go usage limits (5-hour, weekly, monthly) in the TUI footer and in the desktop window corner.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "usage",
    "limits",
    "opencode-go"
  ],
  "exports": {
    ".": "./index.ts",
